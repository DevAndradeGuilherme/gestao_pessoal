# Copie para `backend/.env` (não versionado). Nunca commitar valores reais.

APP_ENV=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# Origens do frontend autorizadas (separadas por vírgula).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Supabase (GP-03/F1) ---
# Origem HTTPS do projeto, sem caminho. Define issuer e JWKS (RS256/ES256) do JWT.
SUPABASE_URL=
# Conexão PostgreSQL SOMENTE no backend (papel capaz de `SET ROLE app_backend`). Nunca no frontend.
DATABASE_URL=
# O uvicorn não lê este arquivo sozinho: `uvicorn app.main:app --env-file .env`.

# --- Testes de integração reais (opcionais; apenas banco de desenvolvimento isolado) ---
# GP03_TEST_DATABASE_URL=
# GP03_TEST_USER_A=   # UUID de um usuário Supabase Auth de teste
# GP03_TEST_USER_B=
# SUPABASE_PUBLISHABLE_KEY=   # chave pública (anon/publishable)
# E2E_USER_A_EMAIL=
# E2E_USER_A_PASSWORD=
# E2E_USER_B_EMAIL=
# E2E_USER_B_PASSWORD=

# --- Integrações futuras (GP-06, GP-07, GP-08, GP-09) ---
# Declaradas pelas tarefas responsáveis, sempre sem valores neste arquivo.
