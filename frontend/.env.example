# Copie para `.env.local` (não versionado). Variáveis NEXT_PUBLIC_* são expostas ao navegador:
# nunca coloque segredos aqui.

# URL base da API FastAPI (sem barra final).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Supabase Auth (GP-03/GP-05) ---
# Somente URL do projeto e chave pública (publishable/anon). Nunca a service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
